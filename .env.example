# SolarCoop — Supabase environment variables
# Copy this file to `.env` and fill in your project's values.
# These keys are safe to expose in client-side code (they are the "anon" key),
# but the `.env` file itself must never be committed.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY


NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY