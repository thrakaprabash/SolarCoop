# Copy to .env.db.local. This local file is ignored by Git.
# CLI login stores account access locally; this token is optional if already logged in.
SUPABASE_ACCESS_TOKEN=
# Used when linking/capturing the full schema; never use an EXPO_PUBLIC_ prefix.
SUPABASE_DB_PASSWORD=
# Optional. Must match the project inferred from the app EXPO_PUBLIC_SUPABASE_URL.
SUPABASE_PROJECT_REF=
